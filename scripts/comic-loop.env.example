# comic-loop.sh 的环境变量示例。复制为 comic-loop.env 后按实际修改。
# 数据库（comic_meta）
PGHOST=127.0.0.1
PGPORT=55432
PGDB=comic_meta
PGUSER=mangrab_rw
PGPASSWORD=change-me
SITE=wnacg

# Mangrab
MANGRAB_URL=http://127.0.0.1:8080
MANGRAB_TOKEN=
LIMIT=20
DRAIN_TIMEOUT=3600

# Mangrab 的 archiveDir（本地盘），以及把它推到哪里（115 库根目录）
ARCHIVE_DIR=/opt/mangrab/archive/wnacg
# 若 ARCHIVE_DIR 本身就是 115 库路径，这两项留空即可
PUSH_SSH=redchen@192.168.31.125
PUSH_DEST=/vol1/1000/docker/clouddrive2/media/115open/content/wnacg

# 对账时读取的库路径（必须是执行机上真实可读的 115 路径）
RECONCILE_ROOT=/mnt/content/wnacg/oneshots
# 可选：对账前刷新挂载视图（NFS 目录缓存会漏掉刚落盘的文件）
RECONCILE_REMOUNT=

# Komga（reconcile 有修复时触发扫描）
KOMGA_URL=http://127.0.0.1:25602
KOMGA_USER=test@local.test
KOMGA_PASS=change-me
KOMGA_LIBRARY=

MODE=all

# 可选：每轮把 Mangrab 的 GET /api/download/stats 追加一行到该文件（jsonl）。
# 留空则不采集。推荐给个持久位置，例如 /opt/loop/download-stats.jsonl
#METRICS_FILE=/opt/loop/download-stats.jsonl
